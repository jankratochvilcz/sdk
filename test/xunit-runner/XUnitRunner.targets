<Project>

  <PropertyGroup>
    <SDKCustomXUnitPublishTargetFramework Condition="'$(SDKCustomXUnitPublishTargetFramework)' == ''">$(SdkTargetFramework)</SDKCustomXUnitPublishTargetFramework>
    <SDKCustomXUnitRuntimeTargetFramework Condition="'$(SDKCustomXUnitRuntimeTargetFramework)' == ''">$(SdkTargetFramework)</SDKCustomXUnitRuntimeTargetFramework>

    <SDKCustomXUnitRunnerVersion Condition="'$(SDKCustomXUnitRunnerVersion)' == ''">$(XUnitV3Version)</SDKCustomXUnitRunnerVersion>

    <_SDKCustomXUnitPublishTargetsPath>$(MSBuildThisFileDirectory)XUnitPublish.targets</_SDKCustomXUnitPublishTargetsPath>

    <SDKCustomXUnitArguments Condition="'$(SDKCustomXUnitArguments)' == ''">-nocolor</SDKCustomXUnitArguments>

    <!-- xUnit v3 runs tests out-of-process via a native AppHost.  When cross-compiling
         (e.g. building on arm64 for x64 Helix queues), set RuntimeIdentifier so the
         AppHost matches the target architecture.  SelfContained=false keeps the publish
         framework-dependent.  ErrorOnDuplicatePublishOutputFiles=false suppresses
         NETSDK1152 from Exe project-references (e.g. dotnet.csproj) whose outputs appear
         in both the plain-TFM and RID-qualified directories. -->
    <_TestPublishRidProperties Condition="'$(TargetRid)' != ''">RuntimeIdentifier=$(TargetRid);SelfContained=false;ErrorOnDuplicatePublishOutputFiles=false</_TestPublishRidProperties>

    <!-- Keep TFM in sync with HelixTasks.csproj -->
    <SDKHelixCustomSdkTaskDll>$(ArtifactsBinDir)HelixTasks\$(Configuration)\HelixTasks.dll</SDKHelixCustomSdkTaskDll>
  </PropertyGroup>

  <UsingTask TaskName="SDKCustomCreateXUnitWorkItemsWithTestExclusion" AssemblyFile="$(SDKHelixCustomSdkTaskDll)" TaskFactory="TaskHostFactory" Runtime="NET" />
  <UsingTask TaskName="TarGzFileCreateFromDirectory" AssemblyFile="$(SDKHelixCustomSdkTaskDll)" TaskFactory="TaskHostFactory" Runtime="NET" />
  <UsingTask TaskName="CreateLocalHelixTestLayout" AssemblyFile="$(SDKHelixCustomSdkTaskDll)" TaskFactory="TaskHostFactory" Runtime="NET" />

  <Choose>
    <When Condition="$(HelixTargetQueue.ToLowerInvariant().Contains('windows'))">
      <PropertyGroup>
        <IsPosixShell>false</IsPosixShell>
      </PropertyGroup>
    </When>
    <Otherwise>
      <PropertyGroup>
        <IsPosixShell>true</IsPosixShell>
      </PropertyGroup>
    </Otherwise>
  </Choose>

  <Target Name="RestoreSDKCustomXUnitProjects"
          Condition="'@(SDKCustomXUnitProject)' != ''"
          BeforeTargets="Restore">
    <MSBuild Projects="@(SDKCustomXUnitProject)"
             Targets="Restore"
             BuildInParallel="true"
             Properties="CustomAfterMicrosoftCommonTargets=$(_SDKCustomXUnitPublishTargetsPath);RuntimeIdentifiers=$(TargetRid)">
    </MSBuild>
  </Target>

  <Target Name="BuildSDKCustomXUnitProjects"
          Condition="'@(SDKCustomXUnitProject)' != ''"
          BeforeTargets="CoreBuild">

    <!-- Assign per-project TargetFramework via AdditionalProperties metadata so that the
         parallel MSBuild call passes the correct TFM to each project. Items without explicit
         TargetFramework metadata get the default SDKCustomXUnitPublishTargetFramework. -->
    <ItemGroup>
      <_XUnitProjectsToPublish Include="@(SDKCustomXUnitProject)" />
      <_XUnitProjectsToPublish Update="@(_XUnitProjectsToPublish)" Condition="'%(_XUnitProjectsToPublish.TargetFramework)' == ''">
        <TargetFramework>$(SDKCustomXUnitPublishTargetFramework)</TargetFramework>
      </_XUnitProjectsToPublish>
      <_XUnitProjectsToPublish Update="@(_XUnitProjectsToPublish)">
        <AdditionalProperties>CustomAfterMicrosoftCommonTargets=$(_SDKCustomXUnitPublishTargetsPath);TargetFramework=%(_XUnitProjectsToPublish.TargetFramework);BuildTestPackages=false;$(_TestPublishRidProperties);%(_XUnitProjectsToPublish.AdditionalProperties)</AdditionalProperties>
      </_XUnitProjectsToPublish>
    </ItemGroup>

    <!-- When the top-level Restore was skipped, restore all projects in parallel to add the
         RID-specific target to assets files (needed for publish with RuntimeIdentifier). -->
    <MSBuild Condition="'$(TargetRid)' != '' and '$(Restore)' != 'true'"
             Projects="@(_XUnitProjectsToPublish)"
             Targets="Restore"
             BuildInParallel="true"
             Properties="CustomAfterMicrosoftCommonTargets=$(_SDKCustomXUnitPublishTargetsPath);RuntimeIdentifiers=$(TargetRid)" />

    <!-- Publish all test projects in parallel. This is the critical optimization:
         previously each project was published sequentially (200+ x ~2s = ~7 min).
         With BuildInParallel, MSBuild's scheduler distributes work across all cores. -->
    <MSBuild Projects="@(_XUnitProjectsToPublish)"
             Targets="PublishWithOutput"
             BuildInParallel="true" />

    <!-- Compute PublishDirectory and TargetPath from Arcade's deterministic output conventions.
         All test projects are published with RuntimeIdentifier=$(TargetRid), so paths follow:
         $(ArtifactsBinDir)<ProjectName>\$(Configuration)\<TFM>\<RID>\publish\  -->
    <ItemGroup>
      <SDKCustomXUnitProject Update="@(SDKCustomXUnitProject)">
        <PublishTargetFramework Condition="'%(SDKCustomXUnitProject.PublishTargetFramework)' == '' and '%(SDKCustomXUnitProject.TargetFramework)' != ''">%(SDKCustomXUnitProject.TargetFramework)</PublishTargetFramework>
        <PublishTargetFramework Condition="'%(SDKCustomXUnitProject.PublishTargetFramework)' == ''">$(SDKCustomXUnitPublishTargetFramework)</PublishTargetFramework>
        <RuntimeTargetFramework Condition="'%(SDKCustomXUnitProject.RuntimeTargetFramework)' == ''">$(SDKCustomXUnitRuntimeTargetFramework)</RuntimeTargetFramework>
      </SDKCustomXUnitProject>
      <SDKCustomXUnitProject Update="@(SDKCustomXUnitProject)" Condition="'$(TargetRid)' != ''">
        <PublishDirectory>$(ArtifactsBinDir)%(Filename)\$(Configuration)\%(SDKCustomXUnitProject.PublishTargetFramework)\$(TargetRid)\publish\</PublishDirectory>
        <TargetPath>$(ArtifactsBinDir)%(Filename)\$(Configuration)\%(SDKCustomXUnitProject.PublishTargetFramework)\$(TargetRid)\%(Filename).dll</TargetPath>
      </SDKCustomXUnitProject>
      <SDKCustomXUnitProject Update="@(SDKCustomXUnitProject)" Condition="'$(TargetRid)' == ''">
        <PublishDirectory>$(ArtifactsBinDir)%(Filename)\$(Configuration)\%(SDKCustomXUnitProject.PublishTargetFramework)\publish\</PublishDirectory>
        <TargetPath>$(ArtifactsBinDir)%(Filename)\$(Configuration)\%(SDKCustomXUnitProject.PublishTargetFramework)\%(Filename).dll</TargetPath>
      </SDKCustomXUnitProject>
    </ItemGroup>
  </Target>

  <Target Name="CreateSDKCustomXUnitWorkItems"
          Condition="'@(SDKCustomXUnitProject)' != ''"
          BeforeTargets="CoreTest">

    <SDKCustomCreateXUnitWorkItemsWithTestExclusion
        XUnitProjects="@(SDKCustomXUnitProject)"
        IsPosixShell="$(IsPosixShell)"
        TargetRid="$(TargetRid)"
        BaseMethodLimit="$(BaseMethodLimit)"
        XUnitArguments="$(SDKCustomXUnitArgument)"
        XUnitWorkItemTimeout="$(XUnitWorkItemTimeout)">
      <Output TaskParameter="XUnitWorkItems" ItemName="HelixWorkItem"/>
    </SDKCustomCreateXUnitWorkItemsWithTestExclusion>
  </Target>

</Project>
